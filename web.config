<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>
    <rewrite><rules>
      <rule name="https-and-host" stopProcessing="true"><match url="(.*)" /><conditions logicalGrouping="MatchAny"><add input="{HTTPS}" pattern="off" /><add input="{HTTP_HOST}" pattern="^binhtiencrane\.com$" negate="true" /></conditions><action type="Redirect" url="https://binhtiencrane.com/{R:1}" redirectType="Permanent" /></rule>
      <rule name="old-0" stopProcessing="true"><match url="^$" ignoreCase="false" /><action type="Redirect" url="/vi/" redirectType="Permanent" /></rule>
      <rule name="old-1" stopProcessing="true"><match url="^vi/hai\-phong\-BRIDGE$" ignoreCase="false" /><action type="Redirect" url="/vi/hai-phong-bridge/" redirectType="Permanent" /></rule>
      <rule name="old-2" stopProcessing="true"><match url="^en/Hai\-Phong\-BRIDGE$" ignoreCase="false" /><action type="Redirect" url="/en/hai-phong-bridge/" redirectType="Permanent" /></rule>
      <rule name="old-3" stopProcessing="true"><match url="^vi/VNT19\-PAPER\-FACTORY$" ignoreCase="false" /><action type="Redirect" url="/vi/nha-may-giay-vnt19/" redirectType="Permanent" /></rule>
      <rule name="old-4" stopProcessing="true"><match url="^en/VNT19\-PAPER\-FACTORY$" ignoreCase="false" /><action type="Redirect" url="/en/vnt19-paper-factory/" redirectType="Permanent" /></rule>
      <rule name="old-5" stopProcessing="true"><match url="^en/Vinfast\-factory$" ignoreCase="false" /><action type="Redirect" url="/en/vinfast-factory/" redirectType="Permanent" /></rule>
      <rule name="old-6" stopProcessing="true"><match url="^en/Nghi\-Son\-Oil\-Refinery$" ignoreCase="false" /><action type="Redirect" url="/en/nghi-son-oil-refinery/" redirectType="Permanent" /></rule>
      <rule name="old-7" stopProcessing="true"><match url="^en/Mong\-Duong\-Thermal\-Power\-Plant$" ignoreCase="false" /><action type="Redirect" url="/en/mong-duong-thermal-power-plant/" redirectType="Permanent" /></rule>
      <rule name="old-8" stopProcessing="true"><match url="^en/Dung\-Quat\-Oil\-Refinery$" ignoreCase="false" /><action type="Redirect" url="/en/dung-quat-oil-refinery/" redirectType="Permanent" /></rule>
      <rule name="old-9" stopProcessing="true"><match url="^vi/bo\-xay\-dung\-day\-nhanh\-giai\-ngan\-von\-dau\-tu\-cong\-nam\-2023$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-10" stopProcessing="true"><match url="^vi/xay\-dung\-2\-du\-thuy\-dien\-tren\-song\-hong$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-11" stopProcessing="true"><match url="^vi/hieu\-ap\-dung\-quy\-chuan\-toan\-chay\-cho\-nha\-va\-cong\-trinh$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-12" stopProcessing="true"><match url="^vi/campuchia\-sap\-khoi\-cong\-tuyen\-cao\-toc\-tu\-phnom\-penh\-toi\-bavet$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-13" stopProcessing="true"><match url="^vi/bat\-dong\-san\-ha\-long\-dan\-soi\-dong\-tro\-lai$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-14" stopProcessing="true"><match url="^vi/khai\-mac\-trien\-lam\-contech\-vietnam\-2023$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-15" stopProcessing="true"><match url="^vi/binh\-dinh\-lay\-y\-kien\-ve\-khu\-do\-thi\-dich\-vu\-canh\-vinh$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-16" stopProcessing="true"><match url="^vi/so\-luong\-quy\-hoach\-phai\-hoan\-thanh\-trong\-nam\-2023$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-17" stopProcessing="true"><match url="^vi/ha\-tinh\-cong\-bo\-quy\-hoach\-thoi\-ky\-den\-2030$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-18" stopProcessing="true"><match url="^vi/don\-luc\-dot\-pha\-ket\-cau\-ha\-tang\-giao\-thong$" ignoreCase="false" /><action type="Redirect" url="/vi/tin-tuc/" redirectType="Permanent" /></rule>
      <rule name="old-19" stopProcessing="true"><match url="^en/binh\-thuan\-curb\-property\-speculation$" ignoreCase="false" /><action type="Redirect" url="/en/news/" redirectType="Permanent" /></rule>
      <rule name="old-20" stopProcessing="true"><match url="^en/danang\-land\-speculation\-spikes\-after\-factory\-relocation$" ignoreCase="false" /><action type="Redirect" url="/en/news/" redirectType="Permanent" /></rule>
      <rule name="old-21" stopProcessing="true"><match url="^en/hcm\-city\-tackles\-property\-speculation$" ignoreCase="false" /><action type="Redirect" url="/en/news/" redirectType="Permanent" /></rule>
      <rule name="old-22" stopProcessing="true"><match url="^en/contractors\-race\-complete\-three\-north\-south\-expressway\-projects\-end\-month$" ignoreCase="false" /><action type="Redirect" url="/en/news/" redirectType="Permanent" /></rule>
      <rule name="old-23" stopProcessing="true"><match url="^en/least\-million\-social\-houses\-be\-built\-2030$" ignoreCase="false" /><action type="Redirect" url="/en/news/" redirectType="Permanent" /></rule>
    </rules></rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace"><remove statusCode="404" subStatusCode="-1" /><error statusCode="404" path="/404.html" responseMode="ExecuteURL" /></httpErrors>
  </system.webServer>
</configuration>
